{
	local_certs
	admin off
	on_demand_tls {
		ask {$LUMIO_TLS_ASK_URL:http://api:49100/api/v1/public/tls/ask}
	}
}

lumio.localhost {
	reverse_proxy api:49100
}

admin.lumio.localhost {
	reverse_proxy admin:80
}

# Free subdomains: one wildcard certificate covers every site.
*.lumio.localhost {
	reverse_proxy renderer:49200
}

# Custom domains: Caddy asks the API before issuing a certificate, so only
# domains that finished DNS verification get one
# (docs/design/18-deployment.md 18.5).
https:// {
	tls {
		on_demand
	}
	reverse_proxy renderer:49200
}
