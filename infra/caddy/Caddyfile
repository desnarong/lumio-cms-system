# Development Caddyfile: plain HTTP, no certificates.
#
# Hosts follow PUBLIC_ROOT_DOMAIN so a free site really is
# <subdomain>.example.com (the same host the renderer resolves).
# Production uses infra/caddy/Caddyfile.prod with ACME certificates instead.

{
	admin off
}

# Public API (used by the browser and by curl during development).
http://{$PUBLIC_ROOT_DOMAIN:example.com} {
	reverse_proxy api:49100
}

# Back office.
http://{$ADMIN_HOST:admin.example.com} {
	reverse_proxy admin:80
}

# Every free subdomain, e.g. http://baandoi.example.com:49700
http://*.{$PUBLIC_ROOT_DOMAIN:example.com} {
	reverse_proxy renderer:49200
}
