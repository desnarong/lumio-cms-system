# Production Caddyfile.
#
# Run with:
#   CADDYFILE=./infra/caddy/Caddyfile.prod \
#   docker compose --env-file .env.docker --profile app up -d --build
#
# Required environment (see .env.docker.example):
#   PUBLIC_ROOT_DOMAIN, ADMIN_HOST, ACME_EMAIL, LUMIO_TLS_ASK_URL
#
# Every hostname below needs a DNS record pointing at this server:
#   <root domain>, *.<root domain>, <admin host>, api.<root domain>
#
# On a server where another stack already owns ports 80/443, do not run this
# container: use infra/nginx/lumio-vps.conf behind the existing Nginx instead
# (docs/DEPLOY-VPS.md).

{
	admin off
	email {$ACME_EMAIL}
	on_demand_tls {
		ask {$LUMIO_TLS_ASK_URL}
	}
}

# Back office.
{$ADMIN_HOST} {
	encode zstd gzip
	reverse_proxy admin:80
}

# Public API. The admin SPA is built with this address and the browser calls it
# directly, so it must have its own certificate (not the on-demand path).
api.{$PUBLIC_ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:49100
}

# The root domain belongs to the operator, so Caddy gets its certificate the
# normal way. The on-demand ask hook only knows about verified customer domains
# and would refuse this one.
{$PUBLIC_ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy renderer:49200
}

# Free sites and custom domains. Certificates are requested on demand and Caddy
# asks the API first, so only verified domains get one. Wildcards need a DNS
# challenge, so each hostname is requested on its own.
*.{$PUBLIC_ROOT_DOMAIN} {
	encode zstd gzip
	tls {
		on_demand
	}
	reverse_proxy renderer:49200
}

# Custom domains added by customers.
https:// {
	encode zstd gzip
	tls {
		on_demand
	}
	reverse_proxy renderer:49200
}
