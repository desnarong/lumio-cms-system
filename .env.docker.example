# Production settings for the all-in-one Docker stack.
#
#   cp .env.docker.example .env.docker
#   # fill in the values, then
#   docker compose --env-file .env.docker --profile app up -d --build
#
# `.env.docker` is ignored by git. Never commit real secrets.
# Consumed by compose for Caddy and the admin build (not by the apps).
LUMIO_DOMAIN=example.com
LUMIO_ADMIN_HOST=admin.example.com
LUMIO_ADMIN_API_URL=https://api.example.com
LUMIO_API_URL=https://api.example.com

# --- Core ---
NODE_ENV=production
# Domain you own. Free sites get <subdomain>.this-domain.
PUBLIC_ROOT_DOMAIN=example.com
# Admin address (served by Caddy) and the API address the browser calls.
ADMIN_HOST=admin.example.com
ADMIN_API_URL=https://api.example.com
API_PUBLIC_URL=https://api.example.com
ADMIN_ORIGIN=https://admin.example.com
RENDERER_ORIGIN=https://example.com
ACME_EMAIL=admin@example.com
CADDYFILE=./infra/caddy/Caddyfile.prod
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
LUMIO_TLS_ASK_URL=http://api:49100/api/v1/public/tls/ask
LUMIO_ENV_FILE=.env.docker

# --- Postgres / Redis published ports (bound to 127.0.0.1) ---
POSTGRES_USER=lumio
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=lumio
DB_PORT=49432
REDIS_PORT=49537

# --- Auth (generate new values: openssl rand -base64 32) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
PREVIEW_SECRET=change-me-preview
REVALIDATE_SECRET=change-me-revalidate
# Leave empty to let Lumio create and persist a key in the lumio_data volume.
SECRETS_ENCRYPTION_KEY=
MEDIA_UPLOAD_SECRET=change-me-media-upload
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=24h
TRUST_PROXY=1

# --- Background jobs ---
# `bullmq` lets several API instances and the worker share one backlog.
QUEUE_DRIVER=bullmq
PUBLISH_INLINE=false
MEDIA_INLINE=false
TRASH_PURGE_INLINE=false
MEDIA_PURGE_INLINE=false
SITE_LOCALE_INLINE=false

# --- Media storage ---
# `s3` uses the bundled MinIO (or any S3-compatible store); `local` uses the
# shared `media` volume. The API refuses to start with s3 when keys are missing.
MEDIA_STORAGE=s3
MEDIA_PUBLIC_BASE_URL=https://media.example.com
# Must be reachable from the browser (presigned URLs use it) AND the API.
# For the bundled MinIO, publish it behind Caddy/S3 domain first.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=lumio-media
S3_ACCESS_KEY=lumio
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_INPUT_PIXELS=40000000
# Set to clamav after starting the scanner profile.
MEDIA_SCANNER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# --- Email / billing / publishing ---
EMAIL_FROM=Lumio <no-reply@example.com>
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_RETURN_URL=https://admin.example.com/settings/billing
RENDERER_URL=http://renderer:49200
# Browser-facing renderer used for draft preview links. Must be the public
# renderer address reachable from the editor's browser (not `renderer`).
RENDERER_PUBLIC_URL=https://example.com
RENDERER_CACHE_SECONDS=3600
# Per-site publishing settings (renderer/static host/CDN) live in the admin;
# leave these empty unless you want a deployment-wide fallback.
CDN_PURGE_URL=
CDN_PURGE_SECRET=
STATIC_PUBLISH_URL=
CDN_PUBLISH_SECRET=

# --- Other ---
TRASH_PURGE_INTERVAL_MINUTES=1440
MEDIA_PURGE_INTERVAL_MINUTES=1440
PUBLIC_DEFAULT_SITE=baandoi
TEMPLATES_DIR=/repo/templates
