# --- Core ---
NODE_ENV=development
API_PORT=49100
# Origin the API is reachable at; used for presigned upload URLs. In production
# this is the public API domain (https://api.example.com).
API_PUBLIC_URL=http://localhost:49100
# Comma-separated browser origins allowed to sign in (localhost / 127.0.0.1 / Caddy host)
ADMIN_ORIGIN=http://localhost:49300,http://127.0.0.1:49300,http://admin.example.com:49700
# Transactional email (orders). Without a key the API logs messages instead.
RESEND_API_KEY=
EMAIL_FROM=Lumio <no-reply@example.com>
RENDERER_ORIGIN=http://localhost:49200
# Number of trusted reverse-proxy hops in front of the API. Express only trusts
# X-Forwarded-For up to this many hops, so `request.ip` (used by the rate
# limiter) is the real client. 1 = the bundled Caddy proxy; 0 = expose the API
# directly. Accepts a hop count, "true" (trust all, not recommended) or "false".
TRUST_PROXY=1

# --- Database (PostgreSQL 16) ---
# production: ใช้ role ที่ไม่ใช่เจ้าของตาราง (และไม่ใช่ superuser) เพื่อให้ RLS มีผลจริง
DATABASE_URL=postgresql://lumio:lumio@localhost:49432/lumio?schema=public

# --- Cache / Queue (Redis 7) ---
# Used for the shared rate limit counters and, when QUEUE_DRIVER=bullmq, for the
# publish/media job queues. When empty the API keeps counters in memory, which is
# only correct for one instance.
REDIS_URL=redis://localhost:49537
# Where background jobs live: `memory` keeps them inside the API process (the
# default, and what PUBLISH_INLINE/MEDIA_INLINE drain); `bullmq` puts them in
# Redis so several API instances and workers share one backlog (needs REDIS_URL).
QUEUE_DRIVER=memory

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
# Signs draft preview links and is never sent to a browser
PREVIEW_SECRET=change-me-preview
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# Encrypts secrets that site owners enter in the admin (bank/shop/CDN keys).
# Optional: when empty, Lumio generates a key on first use and keeps it in
# <LUMIO_DATA_DIR|.lumio-data>/secrets.key (mode 0600). Set this only when you
# want to control the key yourself (for example to share it between containers
# or restore it with a backup). Rotating it requires every site to re-enter its
# stored secrets.
SECRETS_ENCRYPTION_KEY=
# Folder for the generated installation key. Default: ./.lumio-data
LUMIO_DATA_DIR=

# --- Object storage (S3-compatible / MinIO) ---
# Used when MEDIA_STORAGE=s3; the API refuses to start if the bucket or the
# credentials are missing, instead of writing to a bucket named "undefined".
S3_ENDPOINT=http://localhost:49600
S3_REGION=us-east-1
S3_BUCKET=lumio-media
S3_ACCESS_KEY=lumio
S3_SECRET_KEY=lumio-secret
S3_FORCE_PATH_STYLE=true

# --- Media library (docs/design/12-api.md 12.6) ---
# `local` writes files to MEDIA_LOCAL_DIR and serves them from the API's own
# /media mount; `s3` presigns uploads against the S3_* settings above (the
# stored object is re-checked for size and real format when the client confirms).
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=apps/api/.media
# Signs the presigned upload URL (falls back to JWT_ACCESS_SECRET when empty)
MEDIA_UPLOAD_SECRET=change-me-media-upload
MEDIA_UPLOAD_TTL_MINUTES=15
# API drains media jobs itself; set to false to leave them to the worker
MEDIA_INLINE=true
# Decoded-pixel cap for every sharp call (decompression-bomb guard)
MEDIA_MAX_INPUT_PIXELS=40000000

# Virus scanning for uploads (docs/design/15-security.md 15.3). `none` keeps the
# format/size checks only; `clamav` speaks the clamd INSTREAM protocol over TCP
# and fails closed when clamd is unreachable.
MEDIA_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# --- Templates (docs/design/08-theme-design-panel.md 8.2) ---
# Folder of template packs (manifest/tokens/global-blocks/section-styles/pages).
# The repo layout is found automatically; set this only for a custom location.
TEMPLATES_DIR=

# --- Docker stack hostnames (compose only) ---
# Distinct names because a shell-level PUBLIC_ROOT_DOMAIN would otherwise
# override the compose file and point Caddy at the wrong domain.
LUMIO_DOMAIN=example.com
LUMIO_ADMIN_HOST=admin.example.com
LUMIO_ADMIN_API_URL=http://localhost:49100
LUMIO_API_URL=http://localhost:49100

# --- Public site ---
NEXT_PUBLIC_API_URL=http://localhost:49100
# Runtime-only API base for server-side rendering inside Docker (compose sets it
# to http://api:49100). Empty on a host install, where NEXT_PUBLIC_API_URL is used.
API_INTERNAL_URL=
VITE_API_URL=http://localhost:49100
# Domain YOU OWN for the admin's "open my site" links. example.com is a reserved
# placeholder; replace it before publishing anything.
VITE_PUBLIC_ROOT_DOMAIN=example.com
# Domain your free subdomains hang off (baandoi.<your-domain>). Use a domain you
# control: order links and emails fall back to this value.
PUBLIC_ROOT_DOMAIN=example.com
# Caddy calls this before issuing an on-demand TLS certificate for a custom domain
LUMIO_TLS_ASK_URL=http://api:49100/api/v1/public/tls/ask
# Loopback preview only: which site http://localhost:49200 shows
PUBLIC_DEFAULT_SITE=baandoi
# Public base URL for media files (empty → the API's own /media mount of MEDIA_LOCAL_DIR)
MEDIA_PUBLIC_BASE_URL=

# --- Publish pipeline (docs/design/10-architecture.md 10.4) ---
# Renderer the worker asks to rebuild pages
RENDERER_URL=http://localhost:49200
# Public renderer origin used in preview links opened by the browser
RENDERER_PUBLIC_URL=http://localhost:49200
REVALIDATE_SECRET=change-me-revalidate
# Seconds each host's page data stays cached before a rebuild (renderer)
RENDERER_CACHE_SECONDS=3600
# API drains the queue itself; set to false to leave it to the worker process
PUBLISH_INLINE=true

# --- Trash (docs/design/05-admin-ia.md 5.1 "Backup & ประวัติเวอร์ชัน") ---
# How often the worker deletes pages that aged out of the trash (minutes).
# 1440 = once a day; the retention window itself is 30 days (packages/shared).
TRASH_PURGE_INTERVAL_MINUTES=1440
# The worker owns the purge; set to true to let the API do it too (local dev
# without the worker running).
TRASH_PURGE_INLINE=false
# Same sweep for images in the media trash: after 30 days the files are deleted.
MEDIA_PURGE_INTERVAL_MINUTES=1440
MEDIA_PURGE_INLINE=false
# The other languages of a new site are copied and translated in the background.
# Set to false on the API when a separate worker owns the queue.
SITE_LOCALE_INLINE=true

# --- Billing (docs/design/18-deployment.md 18.7) ---
# Stripe Checkout handles both cards and PromptPay (Thai QR). Leave empty to
# disable payments; the billing screen then explains the gateway is not connected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the owner after paying or cancelling.
BILLING_RETURN_URL=http://localhost:49300/settings/billing
# Unused time on the current plan is credited when the owner switches plans; no
# extra setting is needed. Renewal invoices keep charging the full monthly price.
# Card payments renew monthly, so the webhook endpoint must also receive:
# invoice.paid, invoice.payment_failed, customer.subscription.updated,
# customer.subscription.deleted (plus the checkout.session.* events).


# --- CDN / static publishing ---
# Not needed: each site pastes its own renderer, static host and CDN addresses
# in ตั้งค่า › การเผยแพร่ (stored in sites.settings.publish, keys encrypted).
# The values below are only a deployment-wide fallback for sites that have not
# opened that screen yet; leave them empty for a fresh install.
CDN_PURGE_URL=
CDN_PURGE_SECRET=
STATIC_PUBLISH_URL=
CDN_PUBLISH_SECRET=

# --- Apps (docs/design/16-apps.md) ---
# Platform kill switch: true stops installing and every bridge call, while the
# store stays visible. `APPS_EXTERNAL_ENABLED=false` blocks developer-hosted
# manifests but keeps the first-party catalog. Manifests must be https on a
# public host; `APPS_ALLOW_HTTP_MANIFEST` exists for local development only.
APPS_PLATFORM_DISABLED=false
APPS_EXTERNAL_ENABLED=true
APPS_ALLOW_HTTP_MANIFEST=false
APPS_MANIFEST_TIMEOUT_MS=5000

# --- Backup (docs/design/05-admin-ia.md "Backup & ประวัติเวอร์ชัน") ---
# Original image bytes ride along in the JSON backup while they fit this budget.
# Larger files keep their metadata and are reported as skipped on import.
BACKUP_MEDIA_MAX_BYTES=52428800
BACKUP_MEDIA_FILE_MAX_BYTES=10485760

# --- Analytics (docs/design/05-admin-ia.md "เติบโต › Analytics") ---
# Salt for the rotating visitor hash stored in pageviews. No IP is stored; the
# salt keeps the hash unguessable, so set it to a random value in production.
ANALYTICS_HASH_SALT=change-me-analytics
# Batched page views from a CDN edge or worker (docs/design/14-seo-performance.md).
# The edge posts POST /api/v1/public/:host/collect/batch with this token in
# x-lumio-edge-token; leave empty to keep the batch endpoint closed.
EDGE_COLLECT_TOKEN=


# --- Licence (paid capabilities, docs/design/24-community-licensing.md) ---
# Community needs nothing here. A Pro token enables Membership/Paywall and the
# Block Marketplace once the site also switches them on in Settings › Add-ons.
# Verification is offline: the token is Ed25519-signed and this build only holds
# the vendor's public key (baked in at release). No call home, no telemetry.
LUMIO_LICENSE=
# Normally empty: the owner pastes the licence in Settings › Licence and it is
# stored in the database. Set it here only to pin a licence from deployment config
# (an env token always wins over the stored one).
# Testing/self-issued licences only: base64 SPKI DER or PEM. Leave empty in
# production so the key baked into the release is the one that counts.
LUMIO_LICENSE_PUBLIC_KEY=
# Vendor licence desk for `online` licences (activation, seats, revocation).
# Empty = the install never phones home and uses the token as-is (offline mode).
# From inside a container on this machine the desk is http://host.docker.internal:49800
LUMIO_LICENSE_SERVER=
# How long the last lease keeps working when the desk is unreachable (days).
LUMIO_LICENSE_GRACE_DAYS=14
# Renewal cadence (hours). Shorter reacts to a revocation faster.
LUMIO_LICENSE_REFRESH_HOURS=6

# --- AI assistant (docs/design/09-ai-assistant.md 9.4) ---
# `local` runs the built-in key-free engine (rewrite, alt text, meta tags) and
# refuses translation; `openai` talks to any OpenAI-compatible chat endpoint.
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# How long to wait for the provider before giving up (milliseconds).
AI_TIMEOUT_MS=20000

# Signs reader (customer) session tokens; leave empty for local development only.
READER_SECRET=

# --- Stripe (docs/design/18-deployment.md 18.7) ---
# Live keys in production. The API uses plain REST, so no SDK key is needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public key the admin/renderer can expose to the browser (publishable only).
STRIPE_PUBLISHABLE_KEY=
# Integration test (apps/api/src/modules/billing/stripe.integration.spec.ts)
# runs only when a *test* key is present; it is skipped otherwise and refuses
# anything that does not start with sk_test_.

# --- Updates (docs/design/18-deployment.md 18.8) ---
# The admin shows the installed version on every screen and checks this manifest
# for a newer release. Leave empty to use the project release page
# (https://github.com/desnarong/lumio-cms-system/releases), point it at your own
# JSON ({"version":"0.24.0",...}), or set LUMIO_UPDATE_CHECK=false to hide it.
LUMIO_VERSION=
LUMIO_UPDATE_MANIFEST_URL=
# The project repository is private, so the GitHub release feed needs a token.
# A read-only token is enough; it stays on the server and is never sent to the
# browser (the admin only sees the version numbers). GITHUB_TOKEN also works.
LUMIO_UPDATE_TOKEN=
LUMIO_UPDATE_CHECK=true
# Reuse a check for this many minutes (default 360 = every 6 hours).
LUMIO_UPDATE_CHECK_MINUTES=360
# Display only: tells the admin that a host timer will install updates by itself.
# The actual update runs `node scripts/update.mjs` (or `--auto`) on the host.
LUMIO_AUTO_UPDATE=false
# Used by scripts/update.mjs: how often --auto checks, and where the new stack
# must answer before the update counts as successful.
LUMIO_UPDATE_INTERVAL_MINUTES=360
LUMIO_HEALTH_URL=http://127.0.0.1:49100/api/health
LUMIO_UPDATE_HEALTH_TIMEOUT_SECONDS=180
